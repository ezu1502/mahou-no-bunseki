class Analysis:
    samples: list[float]
    frame_count: int

    def __init__(self, samples: list[float], frame_count: int) -> None: ...

    def ptp_amplitude(self) -> float: ...
    def peak_amplitude(self) -> float: ...
    def rms(self) -> float: ...
    def dc_offset(self) -> float: ...
    def crest_factor(self) -> float: ...
    def zero_crossing_rate(self) -> float: ...

    def silence_detection(self, window_size_ms: int = 20, threshold: float = 0.01) -> list[tuple[float, float]]: ...


class Transform:
    def __init__(self, samples: list[float], frame_count: int) -> None: ...

    samples: list[float]
    frame_count: int

    def dft(self) -> list[complex]: ...
    def fft(self) -> list[complex]: ...
    
    def mono_samples(self) -> list[float]: ...

def read_samples(song_path: str) -> tuple[list[float], int] | None: ...