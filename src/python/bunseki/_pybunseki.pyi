class _Constants:
    SAMPLE_RATE: int
    PI: float

    STANDARD_WINDOW_SIZE: int
    STANDARD_HOP_SIZE: int

class _Buntools:
    constants: _Constants

    def is_power_of_two(self, number: int) -> bool: ...
    def samples_to_mono(self, samples: list[float]) -> list[float]: ...

    def generate_sine_wave(self, frequency: float, time: float, sample_rate: int = 44100) -> list[float]: ...

    def read_dataset(self, csv_path: str) -> dict[str, int]: ...

buntools: _Buntools

def read_samples(song_path: str, to_mono: bool = True) -> list[float]: ...

class FrequencyBin:
    frequency: float
    magnitude: float

class Analysis:
    def rms(self) -> float: ...
    def p2p_amplitude(self) -> float: ...
    def peak_amplitude(self) -> float: ...
    def zero_crossing_rate(self) -> float: ...

    def silence_detection(self, threshold: float = 0.01) -> list[tuple[float, float]]: ...
    def rms_windows(self, window_size: int = 1024, hop_size: int = 441) -> list[float]: ...

    def onset_detection(self, threshold: float, min_spacing: int = 2) -> list[int]: ...
    def onset_intervals(self) -> list[int]: ...
    def onset_bpm(self) -> float: ...

    def auto_correlation(self) -> list[float]: ...

    def peak_detection(self, rms_values: list[float]) -> list[int]: ...
    def lag_bpm(self) -> float: ...


class Transform:
    def dft(self) -> list[complex]: ...

    def fft(self) -> list[complex]: ...
    def fft_frequencies(self) -> list[FrequencyBin]: ...

    def stft(self, window_size: int = 1024, hop_size: int = 441) -> list[list[FrequencyBin]]: ...
    def stft_frequencies(self, window_size: int = 1024, hop_size: int = 441) -> list[list[FrequencyBin]]: ...

    def spectral_centroid(self) -> float: ...

class CBunseki:
    def __init__(self, samples: list[float]) -> None: ...

    @property
    def samples(self) -> list[float]: ...

    @property
    def frame_count(self) -> int: ...

    @property
    def analysis(self) -> Analysis: ...

    @property
    def transform(self) -> Transform: ...
    
